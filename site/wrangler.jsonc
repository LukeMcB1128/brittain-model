{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brittain-app",
  "main": "server/worker.js",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brittain-app",
      "database_id": "15d1a694-eeb7-4d7c-ad60-c2964086e114",
      "migrations_dir": "drizzle"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "4005",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "AUTH_EMAIL_RATE_LIMITER",
      "namespace_id": "4006",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "4004",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_CAPACITY", "class_name": "ChatCapacity" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatCapacity"] }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://brittain.app",
    "MODEL_API_ORIGIN": "https://fragility-devoutly-dazzling.ngrok-free.dev",
    "AUTH_EMAIL_FROM": "Brittain <accounts@brittain.app>",
    "CHAT_MAX_CONCURRENT": "4",
    "CHAT_ENABLED": "true",
    "CHAT_MAX_PER_HOUR": "621",
    "CHAT_LOCK_TIMEOUT_SECONDS": "210"
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "BRITTAIN4_API_KEY"]
  },
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "brittain-app-staging",
      "d1_databases": [{
        "binding": "DB",
        "database_name": "brittain-app-staging",
        "database_id": "f0376451-2abf-47e9-b938-dfb007402221",
        "migrations_dir": "drizzle"
      }],
      "durable_objects": {
        "bindings": [{ "name": "CHAT_CAPACITY", "class_name": "ChatCapacity" }]
      },
      "ratelimits": [
        { "name": "AUTH_RATE_LIMITER", "namespace_id": "4007", "simple": { "limit": 20, "period": 60 } },
        { "name": "AUTH_EMAIL_RATE_LIMITER", "namespace_id": "4008", "simple": { "limit": 3, "period": 60 } },
        { "name": "CHAT_RATE_LIMITER", "namespace_id": "4009", "simple": { "limit": 5, "period": 60 } }
      ],
      "vars": {
        "BETTER_AUTH_URL": "https://brittain-app-staging.luke-brittain.workers.dev",
        "AUTH_EMAIL_FROM": "",
        "MODEL_API_ORIGIN": "https://model-not-configured.invalid",
        "CHAT_ENABLED": "false",
        "CHAT_MAX_CONCURRENT": "1",
        "CHAT_MAX_PER_HOUR": "20",
        "CHAT_LOCK_TIMEOUT_SECONDS": "210"
      },
      "secrets": { "required": ["BETTER_AUTH_SECRET", "TURNSTILE_SITE_KEY", "TURNSTILE_SECRET_KEY"] }
    }
  }
}
