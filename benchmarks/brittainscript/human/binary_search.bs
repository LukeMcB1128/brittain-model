func binary_search(values, target):
    low = 0
    high = (len(values) - 1)
    while (low <= high):
        middle = floor(((low + high) / 2))
        cond (values[middle] == target):
            return middle
        end
        cond (values[middle] < target):
            low = (middle + 1)
        else:
            high = (middle - 1)
        end
    end
    return (0 - 1)
end
data = [1, 3, 5, 7, 9, 11, 13]
for probe in [1, 7, 13, 4]:
    push(binary_search(data, probe))
end
