{
  "format": "brittain3-training-v1",
  "model_config": "configs/models/shakespeare_18m_pilot.json",
  "tokenizer_path": "tokenizers/brittain-shakespeare-prose-8k/tokenizer.json",
  "output_dir": "checkpoints/shakespeare_18m_pilot",
  "seed": 1337,
  "precision": "bf16",
  "compile": false,
  "optimizer": {
    "betas": [
      0.9,
      0.95
    ],
    "epsilon": 1e-08,
    "weight_decay": 0.1,
    "gradient_clip": 1.0
  },
  "evaluation": {
    "interval": 150,
    "batches": 20,
    "plateau_evaluations": 10,
    "minimum_delta": 0.001
  },
  "stages": [
    {
      "name": "1k-pilot",
      "context": 1024,
      "microbatch": 16,
      "accumulation": 8,
      "updates": 1500,
      "warmup_updates": 100,
      "decay_updates": 400,
      "peak_lr": 0.0006,
      "min_lr": 6e-05,
      "train_data": "data/processed/brittain-shakespeare/train_1024.npz",
      "validation_data": "data/processed/brittain-shakespeare/validation_1024.npz"
    }
  ],
  "compile_note": "Inductor needs Triton, which has no Windows build. Eager was what the 62k tokens/s benchmark measured anyway."
}
