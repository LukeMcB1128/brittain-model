# Model checkpoints (large binaries — keep out of git)
*.pt
*.ckpt
*.safetensors

# Tokenized dataset binaries + downloaded corpora
data/raw/
data/processed/
benchmarks/prompts/prose.txt
# Corpora are large. prepare_bs.py defaults outside this repo for that reason,
# but --out can point back in here, and a 130MB blob commits fine then fails at
# push (GitHub rejects >100MB).
data/**/*.jsonl

# Build artifact: rewritten by every prepare_*.py run
data/**/meta.pkl

# NOTE: tokenizers/brittain2-code-32k/tokenizer.json IS committed on purpose.
# Re-running scripts/prepare/train_tokenizer.py samples The Stack randomly and yields a DIFFERENT
# tokenizer, which would make every existing v2 checkpoint unreadable.

# Logs
*.log
finetune_log.txt
runs/

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode/
